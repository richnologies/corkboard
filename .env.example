# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,https://malviviendo-app.netlify.app

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Database
MONGODB_URI=mongodb://localhost:27017/corkboard

# AWS
AWS_REGION=eu-south-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=corkboard-uploads
AWS_SES_FROM_EMAIL=me@ricardosanchez.dev

# OpenStreetMap Nominatim (required by usage policy)
NOMINATIM_USER_AGENT=Malviviendo/1.0 (your-email@example.com)

# Google Maps Platform (required for chat place search & creation)
# Enable Places API (New) on your Google Cloud project.
GOOGLE_MAPS_API_KEY=AIzaSyD6gDvQdAkyVFEjA4OSqC9xjo6Y7g1AVH4

# OpenAI (required for the chat assistant and visit search indexing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
